{% comment %}
  gb-config-json.liquid
  Per-node fields:
    node_id      — unique string, stable across swaps
    x            — column index (int) or [int,int] for multi-column span
    y            — tier level (1 = floor)
    sku          — default SKU
    setWith      — empty = standalone Single; same value on multiple nodes = linked
                   group. All nodes sharing this value are removed together on a
                   Set swap.
    setAvailable — key into sets{} that lists available Set swap options.
                   Empty = no Set option shown. Same key can be shared by all
                   nodes in a group so they all show the same alternatives.
    fix          — true = locked, cannot be swapped

  single_swaps: { sku → [alternative skus] }   first entry = source sku (revert)
  sets: { setAvailable_key → [ { set_id, label, sku, nodes[] } ] }
{% endcomment %}
